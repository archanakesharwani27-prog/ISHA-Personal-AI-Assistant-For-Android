rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User presence, profiles, devices, chats, contacts, and cross-device command queue
    match /users/{userId} {
      allow read, write: if request.auth != null || userId.matches('guest_.*') || userId.matches('user_.*') || userId.matches('google_.*') || userId.matches('local_.*');

      // Subcollections: devices, inbox, chats, contacts, shared_clipboard
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null || userId.matches('guest_.*') || userId.matches('user_.*') || userId.matches('google_.*') || userId.matches('local_.*');
      }
    }
  }
}
